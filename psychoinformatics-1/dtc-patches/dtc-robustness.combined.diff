+@contextmanager
+def _session_context(session: Session | None) -> Generator[Session, None, None]:
+    """Yield `session`, or a temporary session that is closed afterwards
+
+    This ensures that requests made without an explicit session get the same
+    retry and timeout behaviour as requests that are made with one.
