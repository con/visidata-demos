+    if connect_timeout is None:
+        connect_timeout = _defaults.connect_timeout
+    if read_timeout is None:
+        read_timeout = _defaults.read_timeout
+
+    session = _TimeoutSession(timeout=(connect_timeout, read_timeout))
+    adapter = HTTPAdapter(
+        max_retries=Retry(
+            total=retries,
+            connect=retries,
+            read=retries,
+            status=retries,
+            status_forcelist=RETRY_STATUS_CODES,
