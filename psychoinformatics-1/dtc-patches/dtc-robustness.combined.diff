     """Return a session that can be used to reuse connections
 
+    The session retries requests that failed with a connection error, a read
+    error, or one of the status codes in `RETRY_STATUS_CODES`, waiting
+    `backoff_factor * 2 ** (attempt - 1)` seconds in between, and honouring a
+    `Retry-After` header if the server sends one. Only requests with an
+    idempotent method are retried, i.e. `POST` is not.
+
+    Every request made through the session gets a default timeout, so that an
+    unresponsive server leads to an error instead of to an indefinite wait.
+
+    Parameters that are `None` fall back to the values set with `configure()`.
+
+    :param retries: [optional] how often a failed request is retried
+    :param backoff_factor: [optional] backoff factor for retries, in seconds
+    :param connect_timeout: [optional] timeout for establishing a connection
+    :param read_timeout: [optional] timeout between received bytes
+
     :return: a Session-object that can be passed to most functions in this module
     """
-    return requests.Session()
+    retries = _defaults.retries if retries is None else retries
+    if backoff_factor is None:
